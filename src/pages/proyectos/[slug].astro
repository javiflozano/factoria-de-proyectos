---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Carrusel from '../../components/Carrusel.astro';
import GaleriaVideos from '../../components/GaleriaVideos.astro';
import { ruta } from '../../lib/rutas';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);

const hayGaleria = data.galeria.length > 1;
const descripcion = data.resumen;

// Las rutas de las imágenes viven en el Markdown como «/images/…»; aquí se les
// aplica el base del sitio para que funcionen también en GitHub Pages.
const galeria = data.galeria.map((imagen) => ({ ...imagen, src: ruta(imagen.src) }));
---

<BaseLayout title={data.titulo} description={descripcion} image={data.imagen}>
  <header class="ficha__cabecera">
    {
      data.imagen && (
        <img
          class="ficha__fondo"
          src={ruta(data.imagen)}
          alt=""
          aria-hidden="true"
          width="1600"
          height="900"
        />
      )
    }
    <div class="contenedor ficha__contenido">
      <p class="antetitulo" style="color: var(--naranja-claro)">
        {data.estado === 'desarrollo' ? 'Proyecto en desarrollo' : 'Proyecto destacado'}
      </p>
      <h1>{data.titulo}</h1>
      <p class="ficha__resumen">{data.resumen}</p>
      <p class="ficha__meta">
        {data.curso && <span class="etiqueta">{data.curso}</span>}
        {
          data.ciclos.map((ciclo) => (
            <span class="etiqueta etiqueta--naranja">{ciclo}</span>
          ))
        }
        {
          data.premios.length > 0 && (
            <span class="etiqueta etiqueta--premio">Proyecto premiado</span>
          )
        }
      </p>
    </div>
  </header>

  <div class="contenedor ficha__cuerpo">
    <div>
      {
        data.premios.map((premio) => (
          <p class="premio">
            <strong>{premio.titulo}</strong>
            <span>
              {premio.entidad}
              {premio.anio ? ` · ${premio.anio}` : ''}
            </span>
          </p>
        ))
      }

      <div class="prosa">
        <Content />
      </div>

      {
        hayGaleria && (
          <Carrusel imagenes={galeria} etiqueta={`Imágenes de ${data.titulo}`} />
        )
      }

      <GaleriaVideos videos={data.videos} />

      <p style="margin-top: 2.5rem">
        <a class="boton boton--fantasma" href={ruta('/proyectos/')}>
          ← Volver a todos los proyectos
        </a>
      </p>
    </div>

    <aside class="lateral" aria-label="Datos del proyecto">
      <div class="panel">
        <h2>Ficha</h2>
        <dl>
          {
            data.curso && (
              <>
                <div>
                  <dt>Curso</dt>
                  <dd>{data.curso}</dd>
                </div>
              </>
            )
          }
          {
            data.anio && (
              <div>
                <dt>Año</dt>
                <dd>{data.anio}</dd>
              </div>
            )
          }
          <div>
            <dt>Ciclos</dt>
            <dd>
              {
                data.ciclos.map((ciclo, indice) => (
                  <>
                    {ciclo}
                    {indice < data.ciclos.length - 1 ? <br /> : null}
                  </>
                ))
              }
            </dd>
          </div>
          <div>
            <dt>Estado</dt>
            <dd>{data.estado === 'desarrollo' ? 'En desarrollo' : 'Terminado'}</dd>
          </div>
        </dl>
      </div>

      {
        data.tecnologias.length > 0 && (
          <div class="panel">
            <h2>Tecnologías</h2>
            <ul class="chips">
              {data.tecnologias.map((tecnologia) => (
                <li>{tecnologia}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        data.enlaces.length > 0 && (
          <div class="panel">
            <h2>Más información</h2>
            <ul class="lista-enlaces">
              {data.enlaces.map((enlace) => (
                <li>
                  <a href={enlace.url} target="_blank" rel="noopener noreferrer">
                    {enlace.titulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
</BaseLayout>
